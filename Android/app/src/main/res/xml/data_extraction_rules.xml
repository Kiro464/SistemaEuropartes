<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Keystore keys may not exist after restore; exclude the JWT store. -->
        <exclude domain="sharedpref" path="europartes_secure_session.xml" />
    </cloud-backup>
    <device-transfer>
        <!-- Do not transfer JWTs to another device. -->
        <exclude domain="sharedpref" path="europartes_secure_session.xml" />
    </device-transfer>
</data-extraction-rules>
