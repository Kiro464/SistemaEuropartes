<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Keystore keys may not exist after restore; exclude the JWT store. -->
        <exclude domain="sharedpref" path="europartes_secure_session.xml" />
        <!-- Offline Room data is device/account scoped and may contain Keystore ciphertext. -->
        <exclude domain="database" />
    </cloud-backup>
    <device-transfer>
        <!-- Do not transfer JWTs to another device. -->
        <exclude domain="sharedpref" path="europartes_secure_session.xml" />
        <!-- Do not transfer offline personal data or outbox records to another device. -->
        <exclude domain="database" />
    </device-transfer>
</data-extraction-rules>
